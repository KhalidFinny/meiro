#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

GO_VERSION="1.27.1"
GO_ROOT="$HOME/.local/share/go/$GO_VERSION"
GO_ARCHIVE_DIR="$HOME/.cache/amp/downloads"
GO_ARCHIVE="$GO_ARCHIVE_DIR/go${GO_VERSION}.linux-$(uname -m).tar.gz"
JUST_VERSION="1.58.0"
JUST_ROOT="$HOME/.local/share/just/$JUST_VERSION"
JUST_ARCHIVE_DIR="$GO_ARCHIVE_DIR"

log() {
	printf '[meiro setup] %s %s\n' "$(date --iso-8601=seconds)" "$*"
}

log "Checking GTK 3 runtime"
if ! dpkg-query -W -f='${Status}' libgtk-3-0 2>/dev/null | grep -q 'install ok installed'; then
	if [[ "$(id -u)" -eq 0 ]]; then
		APT=(apt-get)
	elif command -v sudo >/dev/null 2>&1; then
		APT=(sudo -n apt-get)
	else
		printf 'GTK 3 is missing and neither root nor sudo is available.\n' >&2
		exit 1
	fi
	"${APT[@]}" update
	"${APT[@]}" install -y libgtk-3-0
fi

case "$(uname -m)" in
	x86_64)
		GO_SHA256="63d339f0da5ab53635a56f2490a7984dfe12dfcff22ad749f63edaf590168445"
		GO_PLATFORM="amd64"
		JUST_PLATFORM="x86_64"
		JUST_SHA256="4a5cc2f53e6f0f8c59092a6cc38291eb729d46a7dd95d3ae582008881b84931d"
		;;
	aarch64 | arm64)
		GO_SHA256="3450b45a3f9ee8568792736a5c5e70a1f2e9b36c35a8f74958c03e51d7d92bec"
		GO_PLATFORM="arm64"
		JUST_PLATFORM="aarch64"
		JUST_SHA256="748237128c4c40cbdabc65e841d05ceba13cc23a91eaba395495894c1d9764df"
		;;
	*)
		printf 'Unsupported Go architecture: %s\n' "$(uname -m)" >&2
		exit 1
		;;
esac

mkdir -p "$HOME/.local/share/go" "$HOME/.local/bin" "$GO_ARCHIVE_DIR"
if [[ ! -x "$GO_ROOT/bin/go" ]] || [[ "$("$GO_ROOT/bin/go" version 2>/dev/null || true)" != "go version go${GO_VERSION} linux/${GO_PLATFORM}" ]]; then
	GO_ARCHIVE="$GO_ARCHIVE_DIR/go${GO_VERSION}.linux-${GO_PLATFORM}.tar.gz"
	log "Installing Go ${GO_VERSION}"
	if [[ ! -f "$GO_ARCHIVE" ]] || [[ "$(sha256sum "$GO_ARCHIVE" | cut -d ' ' -f 1)" != "$GO_SHA256" ]]; then
		curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${GO_PLATFORM}.tar.gz" -o "$GO_ARCHIVE"
	fi
	echo "$GO_SHA256  $GO_ARCHIVE" | sha256sum --check --status || {
		rm -f "$GO_ARCHIVE"
		printf 'Go archive checksum verification failed.\n' >&2
		exit 1
	}
	TMP_DIR="$(mktemp -d)"
	trap 'rm -rf "$TMP_DIR"' EXIT
	tar -xzf "$GO_ARCHIVE" -C "$TMP_DIR"
	rm -rf "$GO_ROOT"
	mv "$TMP_DIR/go" "$GO_ROOT"
fi

ln -sfn "$GO_ROOT/bin/go" "$HOME/.local/bin/go"
ln -sfn "$GO_ROOT/bin/gofmt" "$HOME/.local/bin/gofmt"

JUST_ARCHIVE="$JUST_ARCHIVE_DIR/just-${JUST_VERSION}-${JUST_PLATFORM}-unknown-linux-musl.tar.gz"
if [[ ! -x "$JUST_ROOT/just" ]] || [[ "$("$JUST_ROOT/just" --version 2>/dev/null || true)" != "just ${JUST_VERSION}" ]]; then
	log "Installing just ${JUST_VERSION}"
	if [[ ! -f "$JUST_ARCHIVE" ]] || [[ "$(sha256sum "$JUST_ARCHIVE" | cut -d ' ' -f 1)" != "$JUST_SHA256" ]]; then
		curl -fsSL "https://github.com/casey/just/releases/download/${JUST_VERSION}/just-${JUST_VERSION}-${JUST_PLATFORM}-unknown-linux-musl.tar.gz" -o "$JUST_ARCHIVE"
	fi
	echo "$JUST_SHA256  $JUST_ARCHIVE" | sha256sum --check --status || {
		rm -f "$JUST_ARCHIVE"
		printf 'just archive checksum verification failed.\n' >&2
		exit 1
	}
	mkdir -p "$JUST_ROOT"
	tar -xzf "$JUST_ARCHIVE" -C "$JUST_ROOT" just
	chmod 0755 "$JUST_ROOT/just"
fi
ln -sfn "$JUST_ROOT/just" "$HOME/.local/bin/just"

PROFILE="$HOME/.bash_profile"
PROFILE_MARKER='# meiro Go and just toolchains'
if ! grep -Fqx "$PROFILE_MARKER" "$PROFILE" 2>/dev/null && ! grep -Fqx '# meiro Go toolchain' "$PROFILE" 2>/dev/null; then
	cat >> "$PROFILE" <<'EOF'

# meiro Go and just toolchains
case ":$PATH:" in
	*:"$HOME/.local/bin":*) ;;
	*) export PATH="$HOME/.local/bin:$PATH" ;;
esac
EOF
fi
export PATH="$HOME/.local/bin:$PATH"
log "Go toolchain ready: $(go version)"
log "just toolchain ready: $(just --version)"
